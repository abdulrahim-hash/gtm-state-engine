# Safe local-development defaults only. Never place production credentials here.
APP_ENV=development
ACTION_MUTATIONS_ENABLED=false
DATABASE_URL=postgresql+psycopg://gtm_state:gtm_state_local@localhost:5432/gtm_state
POSTGRES_DB=gtm_state
POSTGRES_USER=gtm_state
POSTGRES_PASSWORD=gtm_state_local
API_BASE_URL=http://localhost:8000

# M2C developer-test HubSpot read. Copy names to ignored .env.m2c.local.
# Never put a real token or production portal value in this tracked example.
M2C_HUBSPOT_ACCESS_TOKEN=
M2C_HUBSPOT_PORTAL_ID=
M2C_HUBSPOT_CUSTOMER_STAGE_VALUE=customer
M2C_HUBSPOT_STAGE_MAPPING_VERSION=1.0.0
M2C_HUBSPOT_CUSTOMER_COMPANY_ID=
M2C_HUBSPOT_NONCUSTOMER_COMPANY_ID=
